# cda.aitools — Ghostty snippet for cdamux / tmux (merge into ~/.config/ghostty/config)
# Experimental. On macOS, Option-as-Alt is required for tmux M-* binds (e.g. M-p → cdamux --pick).

# OSC 52 / copy from tmux panes (cdamux, Claude, …) → host clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# left = left Option is Alt/Meta ; right Option keeps special characters (π, …)
macos-option-as-alt = left
