# ~/.config/cda-orch-auto.env
# Absolute path to the repo whose GitHub Project board should be polled.
ORCH_REPO=/home/YOU/path/to/repo

# Keep parallel workers low on a shared laptop; raise on a dedicated host.
ORCH_MAX_PARALLEL=1

# Optional: force a specific agent CLI
# ORCH_AGENT=claude -p

# Ensure agent CLIs and gh are on PATH for systemd (user session may differ).
# PATH=/home/YOU/.local/bin:/usr/bin
