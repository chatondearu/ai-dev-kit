{
  "permissions": {
    "allow": [
      "Edit(/__WORKTREE__/**)",
      "Read(//**)",
      "Bash(mkdir *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git merge-base *)",
      "Bash(git merge origin/__DEFAULT__)",
      "Bash(git merge --no-edit origin/__DEFAULT__)",
      "Bash(git merge origin/__DEFAULT__ --no-edit)",
      "Bash(git push origin __BRANCH__)",
      "Bash(git push -u origin __BRANCH__)",
      "Bash(git push --set-upstream origin __BRANCH__)",
      "Bash(git push origin HEAD:__BRANCH__)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(cdamux msg *)",
      "Bash(cdamux state get *)",
      "Bash(jq *)",
      "Bash(foam-board.sh *)",
      "Bash(bash scripts/*)",
      "Bash(sh scripts/*)",
      "Bash(./scripts/*)",
      "Bash(cargo *)",
      "Bash(pnpm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(yarn install *)",
      "Bash(yarn run *)",
      "Bash(yarn test *)",
      "Bash(make *)",
      "Bash(just *)",
      "Bash(mise run *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(pytest *)",
      "Bash(uv run pytest *)",
      "Bash(nix develop -c bash scripts/*)",
      "Bash(nix develop -c cargo *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(gh pr merge *)",
      "Bash(git push *--force*)",
      "Bash(git push -d *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *refs/heads/__DEFAULT__*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git rebase *--exec*)",
      "Bash(git rebase * -x *)",
      "Bash(git push * __DEFAULT__)",
      "Bash(git push * __DEFAULT__ *)",
      "Bash(git push *:__DEFAULT__)",
      "Bash(git push *:__DEFAULT__ *)",
      "Bash(sudo *)",
      "Bash(npm * -g *)",
      "Bash(npm * --global *)",
      "Bash(npm * -g)",
      "Bash(npm * --global)",
      "Bash(pnpm * -g *)",
      "Bash(pnpm * --global *)",
      "Bash(pnpm * -g)",
      "Bash(pnpm * --global)",
      "Bash(yarn global *)",
      "Bash(yarn *--global-folder*)",
      "Bash(yarn *--prefix*)",
      "Bash(pnpm *--global-dir*)",
      "Bash(pnpm *--prefix*)",
      "Bash(npm *--prefix*)",
      "Bash(npm *--location*)",
      "Bash(cargo install *)",
      "Bash(cargo * install*)",
      "Bash(go install *)",
      "Bash(pip install *)",
      "Bash(brew *)",
      "Bash(nix profile *)",
      "Bash(nix-env *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '__GUARD__' '__BRANCH__' '__DEFAULT__'"
          }
        ]
      }
    ]
  }
}
