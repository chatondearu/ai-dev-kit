{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDA graph plan (--graph-plan)",
  "type": "object",
  "required": ["issue", "tasks"],
  "properties": {
    "issue": { "type": "integer" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "paths", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "prompt": { "type": "string" }
        }
      }
    }
  }
}
