{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDA live orch graph (.orch/graph/live/<run_id>.json; current.json points at the latest)",
  "type": "object",
  "required": ["run_id"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "repo": { "type": "string" },
    "session": { "type": "string", "description": "tmux session (#S) that created the run; absent outside tmux" },
    "pid": { "type": "integer", "description": "pid of the creating process (stale check)" },
    "updated_at": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "ok", "blocked"]
    },
    "ended_at": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "phase", "status", "message"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "phase": { "type": "string" },
          "status": { "type": "string" },
          "message": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "cli": { "type": ["string", "null"], "description": "agent CLI of the run (agent, verifier, integrator nodes)" },
          "model": { "type": ["string", "null"], "description": "model set by the tier flags or the pinned command" },
          "effort": { "type": ["string", "null"], "description": "effort set by the tier flags, when the CLI takes one" },
          "tier": { "type": ["string", "null"], "description": "small|medium|large, custom ORCH_TIERS_FILE tier, or pinned (command sets --model)" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
